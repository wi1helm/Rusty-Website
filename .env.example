# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000
RUST_LOG=info

# Local services
DATABASE_URL=postgres://rusty:change-me@127.0.0.1:5432/rusty
CACHE_URL=redis://127.0.0.1:6379

# S3-compatible local object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=rusty-noname
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me
S3_PUBLIC_URL=http://127.0.0.1:9000/rusty-noname

# Docker Compose
POSTGRES_USER=rusty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rusty
POSTGRES_PORT=5432
REDIS_PORT=6379