# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000
RUST_LOG=info
RATE_LIMIT_HMAC_KEY=replace-this-local-only-hmac-key-with-a-real-secret
TRUSTED_PROXY_CIDRS=
ARGON2_MAX_CONCURRENCY=4

# Rate-limit defaults; time windows are seconds.
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
LOGIN_IP_ACCOUNT_LIMIT=5
LOGIN_IP_ACCOUNT_WINDOW_SECONDS=300
SIGNUP_IP_LIMIT=5
SIGNUP_IP_WINDOW_SECONDS=3600
SIGNUP_EMAIL_LIMIT=3
SIGNUP_EMAIL_WINDOW_SECONDS=3600
SIGNUP_DAILY_IP_LIMIT=20
SIGNUP_DAILY_IP_WINDOW_SECONDS=86400

# Local services
DATABASE_URL=postgres://rusty:change-me@127.0.0.1:5432/rusty
CACHE_URL=redis://127.0.0.1:6379

# S3-compatible local object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=rusty-noname
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me

# Docker Compose
POSTGRES_USER=rusty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rusty
POSTGRES_PORT=5432
REDIS_PORT=6379